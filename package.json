{
  "name": "papertech-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "electron": "electron .",
    "electron:dev": "node electron/dev.cjs",
    "electro:dev": "node electron/dev.cjs",
    "build": "vite build",
    "desktop:build": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.papertech.erp",
    "productName": "PaperTech",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.3",
    "@reduxjs/toolkit": "^1.9.5",
    "antd": "^5.10.5",
    "axios": "^1.5.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^5.0.7",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.14.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "vite": "^5.4.1"
  }
}
